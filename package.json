{
  "name": "kria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5231 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5231 --strictPort",
    "typecheck": "tsc -b",
    "typecheck:functions": "tsc -p supabase/typecheck/tsconfig.json",
    "test": "vitest run",
    "db:test": "node supabase/tests/credits.mjs",
    "check": "npm run typecheck && npm run typecheck:functions && npm test && npm run db:test",
    "billing:image": "node scripts/billing-image.mjs",
    "landing:assets": "node scripts/landing-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
