# Segredos das edge functions. Subir com: npx supabase secrets set --env-file supabase/.env
FAL_KEY=<chave do fal.ai>
ANTHROPIC_API_KEY=<chave da API da Anthropic, para o Vynkio AI (copys, roteiros, ideias)>
WEBHOOK_SECRET=<32+ caracteres aleatórios, assina a URL de retorno do fal>
ASAAS_API_KEY=<chave do Asaas, sandbox ou produção>
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=<32+ caracteres, o mesmo cadastrado no painel do Asaas>
APP_URL=http://localhost:5231
