# Front (Vite). Copiar para .env.local
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
# Opcional: mostra "Continuar com Google" depois de ligar o provedor em Auth > Providers
# VITE_AUTH_GOOGLE=true
# Opcional: GA4 para os eventos de conversão (landing_view, cta_click, sign_up, begin_checkout, purchase)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
